# Django Configuration pour la production
SECRET_KEY=your-secret-key-here-min-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com


# Configuration Cloudinary pour les uploads des images
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Configuration CORS pour les requêtes frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com


# Admin User Configuration pour la création automatique lors du déploiement
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password-here

# SUPABASE CONFIGURATION (2026)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key-here

# Backend Django Variables
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_DB_PASSWORD=your-database-password-here

# Option 1 (recommandée sous Windows): utiliser le "pooler" (IPv4 OK)
# Depuis Supabase: Database > Connection string > Connection pooling
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.your-project-id
SUPABASE_DB_NAME=postgres

# Option 2: utiliser le host DB direct (peut être IPv6-only selon réseau)
# SUPABASE_DB_HOST=db.your-project-id.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_NAME=postgres

# Alternative (prioritaire si défini): URL complète de connexion
# DATABASE_URL=postgresql://postgres.your-project-id:your-database-password-here@aws-1-eu-west-1.pooler.supabase.com:6543/postgres